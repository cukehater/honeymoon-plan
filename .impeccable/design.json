  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "화면당 하나뿐인 주 동작(저장, 들어가기, 추가).",
      "html": "<button class=\"ds-btn-primary\">저장</button>",
      "css": ".ds-btn-primary{font-family:var(--font-sans, Montserrat, Pretendard, sans-serif);min-height:44px;padding:0 16px;border:0;border-radius:8px;background:var(--fg,#1b2333);color:var(--bg,#f5f7fa);font-size:15px;font-weight:700;cursor:pointer} .ds-btn-primary:hover{opacity:.9} .ds-btn-primary:focus-visible{outline:2px solid var(--azul,#1f4fa3);outline-offset:2px} .ds-btn-primary:disabled{opacity:.6}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "복사, 숨기기 같은 보조 동작.",
      "html": "<button class=\"ds-btn-outline\">복사</button>",
      "css": ".ds-btn-outline{font-family:var(--font-sans, Montserrat, Pretendard, sans-serif);min-height:44px;padding:0 12px;border:1px solid var(--line,#dde2ea);border-radius:8px;background:transparent;color:var(--fg,#1b2333);font-size:14px;cursor:pointer} .ds-btn-outline:hover{border-color:var(--muted,#5d6779)} .ds-btn-outline:focus-visible{outline:2px solid var(--azul,#1f4fa3);outline-offset:2px}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "삭제 전용. 누르면 한 번 더 확인.",
      "html": "<button class=\"ds-btn-danger\">삭제</button>",
      "css": ".ds-btn-danger{font-family:var(--font-sans, Montserrat, Pretendard, sans-serif);min-height:44px;width:100%;border:1px solid var(--warn,#a3361f);border-radius:8px;background:transparent;color:var(--warn,#a3361f);font-size:14px;font-weight:600;cursor:pointer} .ds-btn-danger:focus-visible{outline:2px solid var(--azul,#1f4fa3);outline-offset:2px}"
    },
    {
      "name": "Choice Chips",
      "kind": "chip",
      "refersTo": "chip-selected",
      "description": "지출 입력의 항목·결제수단 선택. 선택되면 잉크 면.",
      "html": "<div class=\"ds-chips\"><label class=\"ds-chip\"><input type=\"radio\" name=\"c\">항공</label><label class=\"ds-chip\"><input type=\"radio\" name=\"c\" checked>식비</label><label class=\"ds-chip\"><input type=\"radio\" name=\"c\">쇼핑</label></div>",
      "css": ".ds-chips{display:flex;flex-wrap:wrap;gap:8px;font-family:var(--font-sans, Montserrat, Pretendard, sans-serif)} .ds-chip{display:flex;align-items:center;min-height:44px;padding:0 16px;border:1px solid var(--line,#dde2ea);border-radius:9999px;background:var(--surface,#fff);color:var(--fg,#1b2333);font-size:14px;cursor:pointer} .ds-chip input{position:absolute;opacity:0;width:1px;height:1px} .ds-chip:has(input:checked){background:var(--fg,#1b2333);border-color:var(--fg,#1b2333);color:var(--bg,#f5f7fa)} .ds-chip:has(input:focus-visible){outline:2px solid var(--azul,#1f4fa3);outline-offset:2px}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "폼 입력칸. 글자 16px로 아이폰 확대 방지.",
      "html": "<label class=\"ds-field\">메모<input class=\"ds-input\" placeholder=\"\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:4px;font-family:var(--font-sans, Montserrat, Pretendard, sans-serif);font-size:14px;color:var(--muted,#5d6779)} .ds-input{min-height:44px;padding:0 12px;border:1px solid var(--line,#dde2ea);border-radius:8px;background:var(--surface,#fff);color:var(--fg,#1b2333);font:inherit;font-size:16px;caret-color:var(--azul,#1f4fa3)} .ds-input:focus-visible{outline:2px solid var(--azul,#1f4fa3);outline-offset:2px}"
    },
    {
      "name": "Summary Tiles",
      "kind": "card",
      "refersTo": "card-total",
      "description": "경비 요약. 총액 타일만 잉크 면.",
      "html": "<div class=\"ds-tiles\"><div class=\"ds-tile\"><span>결제 완료</span><b>4,238,191원</b></div><div class=\"ds-tile ds-tile-total\"><span>총 예상 경비</span><b>9,126,845원</b></div></div>",
      "css": ".ds-tiles{display:grid;grid-template-columns:1fr 1fr;gap:12px;font-family:var(--font-sans, Montserrat, Pretendard, sans-serif)} .ds-tile{display:flex;flex-direction:column;gap:2px;padding:14px 16px;border:1px solid var(--line,#dde2ea);border-radius:10px;background:var(--surface,#fff);color:var(--fg,#1b2333)} .ds-tile span{font-size:12px;color:var(--muted,#5d6779)} .ds-tile b{font-size:20px;font-weight:400;font-variant-numeric:tabular-nums} .ds-tile-total{background:var(--fg,#1b2333);border-color:var(--fg,#1b2333);color:var(--bg,#f5f7fa)} .ds-tile-total span{color:inherit;opacity:.75}"
    },
    {
      "name": "Tab Bar",
      "kind": "nav",
      "refersTo": "tab-bar",
      "description": "하단 고정 탭 다섯 칸. 활성 탭은 위쪽 2px 막대.",
      "html": "<nav class=\"ds-tabs\"><a>홈</a><a aria-current=\"page\">일정</a><a>경비</a><a>체크리스트</a><a>예약</a></nav>",
      "css": ".ds-tabs{display:flex;border-top:1px solid var(--line,#dde2ea);background:var(--surface,#fff);font-family:var(--font-sans, Montserrat, Pretendard, sans-serif)} .ds-tabs a{position:relative;flex:1;display:flex;align-items:center;justify-content:center;min-height:56px;font-size:13px;color:var(--muted,#5d6779);text-decoration:none;cursor:pointer} .ds-tabs a:hover{color:var(--fg,#1b2333)} .ds-tabs a[aria-current=page]{color:var(--fg,#1b2333);font-weight:600} .ds-tabs a[aria-current=page]::before{content:'';position:absolute;top:0;left:16px;right:16px;height:2px;border-radius:0 0 9999px 9999px;background:var(--fg,#1b2333)}"
    },
    {
      "name": "Timeline Item",
