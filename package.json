{
  "name": "honeymoon-plan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file-if-exists=.env.local src/shared/db/seed.ts",
    "db:generate": "drizzle-kit generate",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:watch": "vitest",
    "steiger": "steiger ./src --fail-on-warnings",
    "knip": "knip",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "browser": "agent-browser",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm steiger && pnpm knip",
    "verify": "pnpm check && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.18",
    "lucide-react": "^1.81.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@feature-sliced/steiger-plugin": "^0.8.2",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "agent-browser": "^0.45.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "knip": "^6.48.0",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "steiger": "^0.10.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.1.2"
  },
  "packageManager": "pnpm@12.23.0",
  "type": "module",
  "engines": {
    "node": "26.x"
  }
}
